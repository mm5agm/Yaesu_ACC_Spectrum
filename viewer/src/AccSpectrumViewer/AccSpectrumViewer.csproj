<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Windows program that shows the radio's scope from the ACC board and
       checks the wiring. It uses the YaesuAccScope library, so it's also the
       library's first real user. The version and common settings are in
       ..\Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AccSpectrumViewer</RootNamespace>
    <AssemblyName>AccSpectrumViewer</AssemblyName>
    <Product>ACC Spectrum Viewer</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\library\src\YaesuAccScope\YaesuAccScope.csproj" />
    <InternalsVisibleTo Include="AccSpectrumViewer.Tests" />
  </ItemGroup>

</Project>
